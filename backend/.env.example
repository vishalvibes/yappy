# Backend (FastAPI) environment. Loaded by backend/app/main.py (load_dotenv).
#
#   cp backend/.env.example backend/.env    # then fill in the blanks
#
# .env is gitignored; .env.example is committed.
# MCP/tooling vars live in the repo-root .env — this file is backend-only.
# The desktop app is separate: Electron/Vite reads electron/.env (VITE_*).

APP_NAME=yappy-backend
ENVIRONMENT=local
PORT=8000
LOG_LEVEL=INFO

# Renderer / web origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- Supabase (local stack; values from `make status` / `supabase status`) ---
SUPABASE_URL=http://127.0.0.1:54321
# New secret key (sb_secret_...) — server-side, replaces legacy service_role.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT — optional fallback during migration.
# SUPABASE_SERVICE_ROLE_KEY=
# "JWT secret" from `supabase status`. Leave unset to use the Supabase CLI default.
SUPABASE_JWT_SECRET=

# --- Inngest ---
# Local dev syncs with the Inngest Dev Server (`make inngest`, :8288).
INNGEST_IS_PRODUCTION=false
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
# Production only (from the Inngest dashboard):
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- OpenAI ---
# Powers /inference, /chat and /chat/stream. Left false, those routes 503 and
# the health matrix reports the `llm` row as disabled.
OPENAI_ENABLED=false
OPENAI_API_KEY=
# GPT-5.6 family (2026-07-09), cheapest → most capable:
#   gpt-5.6-luna   $1/$6 per 1M tokens    fast, high-volume
#   gpt-5.6-terra  $2.50/$15              balanced default
#   gpt-5.6-sol    $5/$30                 flagship reasoning (alias: gpt-5.6)
OPENAI_MODEL=gpt-5.6-terra
# Optional: point at any OpenAI-compatible gateway (Azure /v1, OpenRouter, a
# local server). Leave these COMMENTED OUT rather than blank — the OpenAI SDK
# reads OPENAI_BASE_URL straight from the environment, and an empty value makes
# every call fail with "Request URL is missing an 'http://' protocol".
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=

# --- Web research ---
# LLM-native web search. Empty → falls back to ddgs (DuckDuckGo).
TAVILY_API_KEY=

# --- Sarvam (Speech-to-Text) ---
# Background STT for POST /yaps. https://docs.sarvam.ai/api-reference/speech-to-text/transcribe
SARVAM_API_KEY=
