# ─────────────────────────────────────────────────────────────────────────────
# Yappy — repo-root .env: MCP / tooling variables ONLY.
#
#   cp .env.example .env      # then fill in the blanks
#
# .env is gitignored; .env.example is committed.
#
# Consumed by:
#   • MCP — Claude Code expands ${VAR} in .mcp.json from the SHELL env; it does
#           NOT read this file automatically. Export before launching Claude Code:
#               set -a; source .env; set +a; claude
#           (or add these vars to your ~/.zshrc).
#
# Backend config is separate — see backend/.env (loaded by backend/app/main.py).
# Electron config is separate — see electron/.env (Vite VITE_* vars).
# ─────────────────────────────────────────────────────────────────────────────

# ═══ MCP servers (.mcp.json) ═════════════════════════════════════════════════
# Linear — https://linear.app/settings/api  (or drop the header in .mcp.json for OAuth)
LINEAR_API_KEY=
# Supabase MCP — project ref from your dashboard URL (https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=
# Supabase personal access token (sbp_...) — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
