# Electron / Vite renderer env (copy to electron/.env).
# Keys from `make status` / `supabase status`.

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Prefer publishable key (sb_publishable_...); anon is legacy fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=
